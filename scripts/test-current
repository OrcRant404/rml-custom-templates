#!/usr/bin/env python3
"""Exercise the production snapshot parser and Stage cleanup with sanitizers.

ROBLOX_STUDIO_APP may select a copy of the pinned Studio app. The test reads
three bundled binary places without opening Studio or changing their files.
"""

from pathlib import Path
import os
import re
import shlex
import subprocess
import sys


def unique_section(source: str, start: str, end: str) -> str:
    if source.count(start) != 1 or source.count(end) != 1:
        raise RuntimeError(f"Production snippet changed; review extraction for {start!r}.")
    begin = source.index(start)
    finish = source.index(end, begin)
    line = source.count("\n", 0, begin) + 1
    return f'#line {line} "native/CurrentPlaceSnapshot.mm"\n' + source[begin:finish]


def main() -> int:
    repository = Path(__file__).resolve().parents[1]
    studio = Path(os.environ.get("ROBLOX_STUDIO_APP", str(Path.home() / (
        "Library/Application Support/com.revolution.rml-launcher/studio/versions/"
        "version-5f7ed526d8884288/RobloxStudio.app"
    )))).expanduser()
    fixtures = [studio / "Contents/Resources/content/models/Thumbnails" / name for name in (
        "MakeupEnvironment.rbxl", "MakeupEnvironmentST1.rbxl", "AvatarCyclorama.rbxl"
    )]
    missing = [str(path) for path in fixtures if not path.is_file()]
    if missing:
        raise RuntimeError("Bundled-place fixtures are missing; set ROBLOX_STUDIO_APP to the pinned Studio app:\n"
                           + "\n".join(missing))

    production = repository / "native/CurrentPlaceSnapshot.mm"
    source = production.read_text(encoding="utf-8")
    limits = re.findall(r"^constexpr std::size_t kMaximumPlaceBytes\s*=\s*[^;]+;", source, re.MULTILINE)
    if len(limits) != 1:
        raise RuntimeError("Production place-size limit changed; review test extraction.")
    # Compile the real definitions on every run. The checked-in driver contains
    # inputs and filesystem assertions, with no copy of the parser/destructor.
    snippets = "\n".join((limits[0],
        unique_section(source, "struct Stage {", "struct Request {"),
        unique_section(source, "bool complete_binary_place(", "void write_snapshot(")))
    output = repository / ".agent-work/tests/current-save"
    output.mkdir(parents=True, exist_ok=True)
    (output / "current_snapshot_under_test.inc").write_text(snippets, encoding="utf-8")
    executable = output / "native_current_snapshot"
    compiler = shlex.split(os.environ.get("CXX", "/usr/bin/clang++"))
    if not compiler:
        raise RuntimeError("CXX must name a C++ compiler.")
    subprocess.run([
        *compiler, "-std=c++23", "-Wall", "-Wextra", "-Werror", "-g0",
        "-fsanitize=address,undefined", "-fno-omit-frame-pointer",
        "-ffile-prefix-map=" + str(repository) + "=/src/rml-custom-templates",
        "-I", str(output), str(repository / "tests/native_current_snapshot.cpp"),
        "-o", str(executable),
    ], check=True)
    environment = os.environ.copy()
    for key, required in (("ASAN_OPTIONS", "abort_on_error=1:halt_on_error=1"),
                          ("UBSAN_OPTIONS", "halt_on_error=1:print_stacktrace=1")):
        environment[key] = ":".join(value for value in (environment.get(key), required) if value)
    subprocess.run([str(executable), *(str(path) for path in fixtures)], check=True, env=environment)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"Current-place snapshot tests failed: {error}", file=sys.stderr)
        raise SystemExit(1)
